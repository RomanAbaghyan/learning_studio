# Copy to .env.production; DNS must point to the deployment host.
ACADEMY_DOMAIN=academy.example.com
ACME_EMAIL=admin@example.com
# Optional prebuilt GHCR image, preferably an immutable sha-* tag or digest.
# ACADEMY_IMAGE=ghcr.io/owner/learning_studio:sha-0123456
ACADEMY_SMTP_HOST=
ACADEMY_SMTP_PORT=587
ACADEMY_SMTP_USER=
ACADEMY_SMTP_PASS=
ACADEMY_SMTP_FROM=no-reply@example.com
# Optional tutor provider (leave unset to use local hints).
# ACADEMY_TUTOR_URL=https://provider.example/v1/chat/completions
# ACADEMY_TUTOR_MODEL=model-name
