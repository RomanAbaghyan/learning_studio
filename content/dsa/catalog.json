  "patterns": [
    {
      "id": "boundary",
      "title": "Binary Search on a Boundary",
      "clues": [
        "Sorted data",
        "False then true feasibility",
        "Smallest feasible answer"
      ],
      "model": "Maintain a known-false prefix and known-true suffix.",
      "template": "lo=0; hi=n; while lo<hi: mid=lo+(hi-lo)//2; if P(mid): hi=mid; else: lo=mid+1",
      "example": "Find the first timestamp at or after a request.",
      "mistakes": [
        "Assuming monotonicity without proving it",
        "Mixing inclusive and exclusive endpoints"
      ],
      "topics": [
        "binary-search"
      ]
    },
    {
      "id": "relaxation",
      "title": "Shortest-Path Relaxation",
      "clues": [
        "Nonnegative transition costs",
        "Best cost to each state"
      ],
      "model": "Tentative distances are costs of discovered paths; settle the smallest.",
      "template": "pop minimum; skip stale; for each edge: improve and push",
      "example": "Find cheapest transit through a weighted directed network.",
      "mistakes": [
        "Using a FIFO queue for arbitrary weights",
        "Marking a node final on discovery"
      ],
      "topics": [
        "dijkstra"
      ]
    },
    {
      "id": "knapsack-state",
      "title": "0/1 Choice DP",
      "clues": [
        "Each item used once",
        "Integral resource budget",
        "Maximize additive value"
      ],
      "model": "Separate decisions by item prefix so each item can contribute once.",
      "template": "for each item: for capacity descending: dp[c]=max(dp[c],value+dp[c-weight])",
      "example": "Select jobs under a fixed memory budget.",
      "mistakes": [
        "Ascending capacity accidentally permits reuse",
        "Treating capacity magnitude as input bit length"
      ],
      "topics": [
        "knapsack"
      ]
    },
    {
      "id": "restore-invariant",
      "title": "Restore a Structural Invariant",
      "clues": [
        "Ordered updates",
        "Unbounded height without repair"
      ],
      "model": "First perform a local update, then repair metadata and balance on the ancestor path.",
      "template": "update child; recompute height; inspect balance; rotate; return new subtree root",
      "example": "Maintain a dynamic ordered set with predictable lookup latency.",
      "mistakes": [
        "Dropping the returned root",
        "Updating parent height before child height"
      ],
      "topics": [
        "avl-tree"
      ]
    }
